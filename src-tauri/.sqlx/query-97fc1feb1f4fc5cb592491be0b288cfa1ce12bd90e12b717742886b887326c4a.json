  "query": "SELECT\n               p.id, p.category_id, c.name AS category_name,\n               p.name, p.description, p.brand, p.image_url,\n               p.is_active, p.created_at, p.updated_at\n           FROM products p\n           JOIN categories c ON c.id = p.category_id\n           WHERE p.id = $1",
