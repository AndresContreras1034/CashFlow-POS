  "query": "UPDATE app_settings\n         SET business_name               = COALESCE($1, business_name),\n             tax_id                      = $2,\n             address                     = $3,\n             phone                       = $4,\n             email                       = $5,\n             currency                    = COALESCE($6, currency),\n             tax_rate_bps                = COALESCE($7, tax_rate_bps),\n             ticket_header               = $8,\n             ticket_footer               = $9,\n             low_stock_default_threshold = COALESCE($10, low_stock_default_threshold),\n             logo_url                    = $11\n         WHERE id = 1\n         RETURNING *",
